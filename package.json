{
  "name": "voxa-react",
  "private": true,
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "dev:next": "npm run dev --workspace=voxa-frontend",
    "build:next": "npm run build --workspace=voxa-frontend",
    "build:cloudflare": "npm run build:next && cd packages/voxa-frontend && npx @cloudflare/next-on-pages@1",
    "dev:widget": "npm run dev --workspace=voxa-widget",
    "build:widget": "npm run build --workspace=voxa-widget",
    "publish:widget:ci": "npm run build:widget && npx changeset publish"
  },
  "devDependencies": {
    "@changesets/cli": "^2.28.1",
    "tailwindcss": "^3.4.14",
    "postcss": "^8.4.47",
    "autoprefixer": "^10.4.20"
  }
}
